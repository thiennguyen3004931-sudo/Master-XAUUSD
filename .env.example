# Root project defaults
# Copy app-specific examples instead of putting broker secrets here.

# apps/api/.env.example
# apps/web/.env.example
# packages/mt5-broker/bridge/.env.example

# ---------------------------------------------------------------------------
# hardening/go-live: V6 runtime go-live guard (scripts/v6_go_live_guard.py)
# Copy to .env (gitignored) and fill in. Names only: no values are committed.
# See RUNBOOK.md and GO_LIVE_CHECKLIST.md. Unset = safe default.
# ---------------------------------------------------------------------------
# Execution mode. Default DRY_RUN=true (no broker mutation at all).
XAUUSD_DRY_RUN=
# REAL account new exposure requires BOTH of these (plus the existing ARM).
XAUUSD_LIVE=
XAUUSD_CONFIRM_LIVE=
# Risk (env can only LOWER the hard caps 1.0 / 1.5 / 3.0 / 6.0 percent).
XAUUSD_SIZING_MODE=
XAUUSD_RISK_PER_TRADE_PCT=
XAUUSD_MAX_PORTFOLIO_RISK_PCT=
XAUUSD_MAX_DAILY_LOSS_PCT=
XAUUSD_MAX_WEEKLY_LOSS_PCT=
XAUUSD_MAX_OPEN_POSITIONS=
XAUUSD_MAX_TOTAL_VOLUME_LOTS=
XAUUSD_MAX_SPREAD_USD=
# Độ lệch giá tối đa (point MT5). Mặc định 50 = 0.50 USD. Vào lệnh: tối đa 100; đóng lệnh: tối đa 300.
XAUUSD_ENTRY_DEVIATION_POINTS=
XAUUSD_CLOSE_DEVIATION_POINTS=
# Calendar filters
XAUUSD_NEWS_FILTER_ENABLED=
XAUUSD_NEWS_BLACKOUT_FILE=
XAUUSD_NEWS_BLACKOUT_BEFORE_MIN=
XAUUSD_NEWS_BLACKOUT_AFTER_MIN=
XAUUSD_LOW_LIQUIDITY_FILTER_ENABLED=
XAUUSD_LOW_LIQUIDITY_WINDOWS_UTC=
# Kill switch / clock / reliability
XAUUSD_KILL_SWITCH=
XAUUSD_KILL_SWITCH_FILE=
XAUUSD_MAX_CLOCK_SKEW_SEC=
XAUUSD_CONNECT_ATTEMPTS=
XAUUSD_GUARD_LOG_FILE=
# Broker server UTC offset (hours, required for freshness/daily/weekly loss).
V6_BROKER_UTC_OFFSET_HOURS=
# Alerts (optional). Use a NEW bot token; the old one is compromised.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
XAUUSD_TELEGRAM_FLATTEN_PIN=
XAUUSD_ALERTS_DISABLED=
# Existing V6 server secrets (set them; never rely on code defaults).
ZIQ_V6_CONTROL_TOKEN=
ZIQ_TG_MASTER_SECRET=
